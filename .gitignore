# ---------------------------------------------------------
# Visual Studio generated files
# ---------------------------------------------------------

# Visual Studio's local workspace information.
.vs/

# User-specific Visual Studio settings.
*.user

# Solution user options.
*.suo


# ---------------------------------------------------------
# .NET build output
# ---------------------------------------------------------

# Compiled binaries are generated again during a build,
# so there is no reason to store them in GitHub.
bin/

# Temporary build/intermediate files generated by .NET.
obj/


# ---------------------------------------------------------
# Azure Functions local configuration
# ---------------------------------------------------------

# This file can contain Azure Storage connection strings.
# It must remain on the developer's machine and should
# never be pushed to the public GitHub repository.
local.settings.json


# ---------------------------------------------------------
# Testing and IDE folders
# ---------------------------------------------------------

# Generated test output.
TestResults/

# JetBrains IDE settings, in case Rider is ever used.
.idea/


# ---------------------------------------------------------
# Environment and secret configuration
# ---------------------------------------------------------

# Environment files may contain passwords or credentials.
.env