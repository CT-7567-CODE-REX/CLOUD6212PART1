              "});\r",
              "\r",
              "pm.test(\"Cappuccino was created\", function () {\r",
              "    const data = pm.response.json();\r",
              "\r",
              "    pm.expect(data.item.id).to.eql(\"COF-002\");\r",
              "    pm.expect(data.item.name).to.eql(\"Cappuccino\");\r",
